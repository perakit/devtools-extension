{
  "manifest_version": 3,
  "name": "Web Dev Toolbox",
  "version": "1.0",
  "description": "A comprehensive toolbox for web developers including Responsive Viewer, CSS Inspector, and more.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "downloads",
    "cookies",
    "browsingData",
    "contextMenus",
    "declarativeNetRequest",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Web Dev Toolbox"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["toolbar.css"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content_module.js", "tools/*.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
